{
  "copy_on_select": true,
  "font_size": 18,
  "font_family": "Maple Mono NF CN",
  "code_font": "Maple Mono NF CN",
  "pane_headers": "Always",
  "status_bar": true,
  "material": "Glass",
  "opacity": 15,
{{- if eq .chezmoi.os "windows" }}
  "shell": {{ printf "%s/AppData/Local/Programs/nu/bin/nu.exe" (.chezmoi.homeDir | replace "\\" "/") | toJson }},
{{- end }}
  "keybinds": {
    "alt+1": [],
    "alt+2": [],
    "alt+3": [],
    "alt+4": [],
    "alt+5": [],
    "alt+6": [],
    "alt+7": [],
    "alt+8": [],
    "alt+9": [],
    "alt+=": "equalize",
    "alt+c": "rename_tab",
    "alt+ctrl+e": "resize_split:down",
    "alt+ctrl+i": "resize_split:right",
    "alt+ctrl+n": "resize_split:left",
    "alt+ctrl+u": "resize_split:up",
    "alt+d": "split_down",
    "alt+digit_1": [],
    "alt+digit_2": [],
    "alt+digit_3": [],
    "alt+digit_4": [],
    "alt+digit_5": [],
    "alt+digit_6": [],
    "alt+digit_7": [],
    "alt+digit_8": [],
    "alt+digit_9": [],
    "alt+down": "focus_pane:down",
    "alt+e": "focus_pane:down",
    "alt+f": "zoom",
    "alt+i": "focus_pane:right",
    "alt+left": "focus_pane:left",
    "alt+n": "focus_pane:left",
    "alt+o": "split_right",
    "alt+right": "focus_pane:right",
    "alt+shift+c": "rename_session",
    "alt+shift+e": "move_pane:down",
    "alt+shift+i": "move_pane:right",
    "alt+shift+n": "move_pane:left",
    "alt+shift+t": "new_session",
    "alt+shift+u": "move_pane:up",
    "alt+t": "new_tab",
    "alt+u": "focus_pane:up",
    "alt+up": "focus_pane:up",
    "ctrl+digit_1": "goto_tab:1",
    "ctrl+digit_2": "goto_tab:2",
    "ctrl+digit_3": "goto_tab:3",
    "ctrl+digit_4": "goto_tab:4",
    "ctrl+digit_5": "goto_tab:5",
    "ctrl+digit_6": "goto_tab:6",
    "ctrl+digit_7": "goto_tab:7",
    "ctrl+digit_8": "goto_tab:8",
    "ctrl+digit_9": "goto_tab:9",
    "ctrl+q": "close_pane",
    "ctrl+shift+tab": "previous_tab",
    "ctrl+shift+w": "close_pane",
    "ctrl+tab": "next_tab",
    "ctrl+v": [
      "edit.paste",
      "paste"
    ],
    "ctrl+w": "close_tab"
  }
}
