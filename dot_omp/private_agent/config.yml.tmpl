shellPath: {{ if eq .chezmoi.os "windows" }}{{ lookPath "nu" | quote }}{{ else if eq .chezmoi.os "darwin" }}"/bin/zsh"{{ else }}"/usr/bin/zsh"{{ end }}
modelRoles:
  default: openai-codex/gpt-6-astra:high
  plan: openai-codex/gpt-6-astra:high
  task: opencode-go/deepseek-v4.1-flash:max
  smol: xai-oauth/grok-4.7:high
  tiny: opencode-go/deepseek-v4.1-flash:max
  slow: opencode-go/deepseek-v4.1-flash:max
  designer: kimi-code/k3:max
  commit: opencode-go/deepseek-v4.1-flash:max
  vision: google-antigravity/gemini-3.7-flash:high
  advisor: google-antigravity/gemini-3.8-flash:high
symbolPreset: nerd
theme:
  light: light-catppuccin
  dark: dark-catppuccin
tui:
  tight: true
setupVersion: 2
hideThinkingBlock: true
dev:
  autoqaConsent: granted
defaultThinkingLevel: auto
composer:
  shape: claude
task:
  agentModelOverrides:
    task: "@task"
    designer: "@designer"
    reviewer: openai-codex/gpt-6-astra:high
compaction:
  methodOrder:
    - snapcompact
    - handoff
    - shake
    - soft
terminal:
  showProgress: true
display:
  showTokenUsage: true