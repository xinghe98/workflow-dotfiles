{{- if ne .chezmoi.os "windows" -}}
# {{ include "dot_paseo/directory-plugins.json.tmpl" | sha256sum }}
#!/bin/sh
set -eu
config="${HOME}/.paseo/config.json"
list="${HOME}/.paseo/directory-plugins.json"
[ -f "$config" ] && [ -f "$list" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
python3 - "$config" "$list" <<'PY'
import json, sys

config_path, list_path = sys.argv[1], sys.argv[2]
with open(config_path, encoding="utf-8") as fh:
    config = json.load(fh)
with open(list_path, encoding="utf-8") as fh:
    directory_plugins = json.load(fh)
if not isinstance(config, dict) or not isinstance(directory_plugins, dict):
    raise SystemExit(0)
plugins = config.get("plugins")
if not isinstance(plugins, dict):
    plugins = {}
    config["plugins"] = plugins
plugins.update(directory_plugins)
encoded = json.dumps(config, indent=2, ensure_ascii=False) + "\n"
with open(config_path, encoding="utf-8") as fh:
    current = fh.read()
if current != encoded:
    with open(config_path, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(encoded)
PY
{{ end -}}
